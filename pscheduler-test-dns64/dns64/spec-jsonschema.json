		},
		"nameserver": {
		    "$ref": "#/pScheduler/Host",
		    "title": "Name Server",
		    "description": "Name server to query."
		},
		"host": {
		    "$ref": "#/pScheduler/Host",
		    "title": "Host",
		    "description": "Host to run the test."
		},
		"host-node": {
		    "$ref": "#/pScheduler/Host",
