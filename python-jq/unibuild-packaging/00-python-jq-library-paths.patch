 _compilation_lock = threading.Lock()
 
+cdef object _set_library_paths(jq_state *jq, object library_paths):
+    """
+    Configure the jq instance's library search path if there is one.
+    Returns None if OK or an Exception (not raised) if there was a problem.
+    """
+
+    if library_paths is not None:
+        # Use the provided list
+        if (not isinstance(library_paths, list)) \
+           or (list(filter(lambda value: not isinstance(value, str), library_paths))):
+            return ValueError('library_paths must be an array of strings')
+        paths = library_paths
+    else:
+        # Emulate the CLI's behavior.  This has to be re-implemented
+        # here because it's hard-wired into the CLI.
+        paths = [ "~/.jq" ]
+
+        try:
+            jq_program = "jq.exe" if platform.system() == "Windows" else "jq"
+            origin = list(filter(
+                lambda p: os.access(os.path.join(p, jq_program), os.X_OK),
+                os.environ["PATH"].split(os.pathsep)
+            ))[0]
+            paths.extend([
+                f"{origin}/{path}"
+                for path in ["../lib/jq", "lib"]
+            ])
+        except IndexError:
+            # If there's no jq binary, don't do anything relative to it.
+            pass
+
+    paths = [ os.path.expanduser(path) for path in paths ]
 
