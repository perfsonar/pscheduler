+cdef jv _python_to_jv(object obj):
+    """Convert a Python object to a JSON value"""
+    if isinstance(obj, str):
+        obj = obj.encode("utf-8")
+        return jv_string_sized(obj, len(obj))
+    elif isinstance(obj, (list, tuple)):
+        jvalue = jv_array()
+        for _, item in enumerate(obj):
+            jvalue = jv_array_append(jvalue, _python_to_jv(item))
+        return jvalue
+    else:
+        raise TypeError(f"Cannot convert {type(obj)} to JSON")
