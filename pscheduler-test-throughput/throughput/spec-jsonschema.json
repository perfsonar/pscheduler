{
    "#": "This gets merged into every version as #/local.",
    "local": {
        "congestion": {
	    "#": "Schemas 1-3",
            "type": "string",
            "enum": [
		"bbr",
		"bic",
		"cubic",
		"htcp",
		"reno",
		"vegas",
		"westwood",
                "yeah"
	    ],
	    "title": "Congestion",
	    "description": "Congestion control algorithm to be used.",
	    "x-description-append": "Valid values are bbr, bic, cubic, htcp, reno, vegas, westwood and yeah."
        },


        "congestion-unvalidated": {
	    "#": "Schema 4 and later",
            "type": "string",
            "minLength": 1,
	    "title": "Congestion",
	    "description": "Congestion control algorithm to be used.",
	    "x-description-append": "Any value is valid, but unsupported congestion control methods will cause measurement failures."
        }
    },

    "#": "The zeroth element of this is always null since there is no version 0.",
    "versions": [
        null,
	
        {
            "type": "object",
            "properties": {
                "schema": {
		    "$ref": "#/pScheduler/Schema",
		    "const": 1
		},
                "source": {
		    "$ref": "#/pScheduler/Host",
		    "title": "Source",
		    "description": "Sending end of the test."
		},
                "source-node": {
		    "$ref": "#/pScheduler/URLHostPort",
		    "title": "Source Node",
                    "description": "pScheduler to contact for the source of the test."
		},
                "dest": {
		    "$ref": "#/pScheduler/Host",
                    "title": "Destination",
                    "description": "Receiving end of the test."
		},
                "dest-node": {
		    "$ref": "#/pScheduler/URLHostPort",
                    "title": "Destination Node",
                    "description": "pScheduler to contact for the destination of the test."
		},
                "duration": {
		    "$ref": "#/pScheduler/Duration",
                    "title": "Duration",
                    "description": "How long to run the measurement."
		},
                "interval": {
		    "$ref": "#/pScheduler/Duration",
                    "title": "Interval",
                    "description": "How often to report results, exclusive of the summary and the end."
		},
                "parallel": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "Parallel",
                    "description": "Number of data streams to run in parallel during the test."
		},
                "udp": {
		    "$ref": "#/pScheduler/Boolean",
                    "title": "UDP",
                    "description": "Test with UDP instead of TCP."
		},
                "bandwidth": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "Bandwidth",
                    "description": "Maximum bandwidth in bits per second."
		},
                "window-size": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "Window Size",
                    "description": "TCP window (buffer) size to use, in bytes."
		},
                "mss": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "MSS",
                    "description": "TCP maximum segment size."

		},
                "buffer-length": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "Buffer Length",
                    "description": "Read/write buffer size, in bytes."
		},
                "ip-tos": {
		    "$ref": "#/pScheduler/IPTOS"
		},
                "ip-version": {
		    "$ref": "#/pScheduler/IPVersion"
		},
                "local-address": {
		    "$ref": "#/pScheduler/Host",
                    "title": "Local Address",
                    "description": "Use this as a local address for the sending end of the test, usually when NAT or PAT is involved."
		},
                "omit": {
		    "$ref": "#/pScheduler/Duration",
                    "title": "Omit",
                    "description": "Amount of time to omit from the start of the tet."
		},
                "no-delay": {
		    "$ref": "#/pScheduler/Boolean",
                    "title": "No Delay",
                    "description": "Set TCP's no-delay flag, disabling Nagle's algorithm."
		},
                "congestion": {
		    "$ref": "#/local/congestion"
		},
                "zero-copy": {
		    "$ref": "#/pScheduler/Boolean",
                    "title": "Zero Copy",
                    "description": "Use zero-copy sending and receiving methods."
		},
                "flow-label": {
		    "$ref": "#/pScheduler/IPv6FlowLabel"
		},
                "client-cpu-affinity": {
		    "$ref": "#/pScheduler/Integer",
                    "title": "Client CPU Affinity",
                    "description": "CPU affinity for the client (source) end of the test."
		},
                "server-cpu-affinity": {
		    "$ref": "#/pScheduler/Integer",
                    "title": "Server CPU Affinity",
                    "description": "CPU affinity for the server (destination) end of the test."
		},
                "reverse": {
		    "$ref": "#/pScheduler/Boolean",
                    "title": "Reverse",
                    "description": "Reverse the direction of the test so the destination sends to the source."
		}
            },
            "additionalProperties": false,
            "required": [ "dest" ]
        },

        {
            "type": "object",
            "properties": {
