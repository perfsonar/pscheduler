{
    "#": "This gets merged into every version as #/local.",
    "local": { },

    "#": "The zeroth element of this is always null since there is no version 0.",
    "versions": [
        null,

	{
            "type": "object",
            "properties": {
                "schema": {
		    "$ref": "#/pScheduler/Schema",
		    "const": 1
		},
                "algorithm": {
		    "$ref": "#/pScheduler/String",
		    "title": "Algorithm",
		    "description": "Trace algorithm"
		},
                "as": {
		    "$ref": "#/pScheduler/Boolean",
		    "title": "Resolve ASes",
		    "description": "Attempt to find autonomous systgem (AS) numbers for the IP address in each hop."
		},
                "dest-port": {
		    "$ref": "#/pScheduler/IPPort",
		    "title": "Destination Port",
                    "description": "Destination Port."
		},
                "dest": {
		    "$ref": "#/pScheduler/Host",
                    "title": "Destiation",
                    "description": "Receiving end for probes."
		},
                "first-ttl": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "First TTL",
                    "description": "Initial IP time-to-live (TTL) value."
		},
                "fragment": {
		    "$ref": "#/pScheduler/Boolean",
                    "title": "Fragment",
                    "description": "Allow fragmentation of packets."
		},
                "hops": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "Hops",
                    "description": "Maximum number of hops."
		},
                "hostnames": {
		    "$ref": "#/pScheduler/Boolean",
                    "title": "Resolve Hostnames",
                    "description": "Resolve IP addresses to hostnames.  The usual default behavior is to do this."
		},
                "ip-tos": {
		    "$ref": "#/pScheduler/IPTOS"
		},
                "ip-version": {
		    "$ref": "#/pScheduler/IPVersion"
		},
                "length": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "Length",
                    "description": "Length of probe packets in bytes."
		},
                "probe-type": {
		    "type": "string",
		    "enum": ["icmp", "udp", "tcp"],
		    "title": "Probe Type",
                    "description": "Type of probe to use.",
		    "x-description-append": "Valid values are icmp, udp and tcp."
		},
                "queries": {
		    "$ref": "#/pScheduler/Cardinal",
                    "title": "Queries",
                    "description": "Number of queries (probes) sent per hop."
		},
                "sendwait": {
		    "$ref": "#/pScheduler/Duration",
                    "title": "Send Wait",
                    "description": "Wait time between probes."
		},
                "source": {
		    "$ref": "#/pScheduler/Host",
                    "title": "Source",
                    "description": "Host that will send probes."
		},
                "source-node": {
		    "$ref": "#/pScheduler/URLHostPort",
                    "title": "Source Node",
                    "description": "pScheduler to contact about the source."
		},
                "wait": {
		    "$ref": "#/pScheduler/Duration",
                    "title": "Wait",
                    "description": "Wait time."
		}
            },
            "required": [
                "dest"
            ]
        },

        {
            "type": "object",
            "properties": {
                "schema": {
		    "$ref": "#/pScheduler/Schema",
		    "const": 2
		},
                "algorithm": null,
                "as": null,
                "dest-port": null,
                "dest": null,
                "first-ttl": null,
                "flow-label":  {
		    "$ref": "#/pScheduler/IPv6FlowLabel"
		},
                "fragment": null,
                "hops": null,
                "hostnames": null,
                "ip-tos": null,
                "ip-version": null,
                "length": null,
                "probe-type": null,
                "queries": null,
                "sendwait": false,
                "source": null,
                "source-node": null,
                "wait": null
            },
            "required": [
		"schema",
                "dest"
            ]
        }
    ]
}
