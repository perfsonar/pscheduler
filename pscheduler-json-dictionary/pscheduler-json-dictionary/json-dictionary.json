{
    "#": "pScheduler JSON Dictionary",

    "pScheduler": {

        "#": "JSON Types",

        "AnyJSON": {
	    "x-description-append": "This can be any valid JSON.",
	    "examples": [ { "foo": "bar" }, "perfSONAR", true, 97, null ],
	    "x-invalid-message": "'%s' is not valid JSON.",
	    "x-info": [
		{
		    "title": "JSON",
		    "href": "https://www.json.org"
		}
	    ]
	},

        "Array": { "type": "array" },

	"ASNumber": {
	    "type": "integer",
	    "minimum": 1,
	    "maximum": 4294967294,
	    "x-description-append": "This can be any autonomous system numeber in [0..4294967294].",
	    "examples": [ 64500, 4200000000 ],
	    "x-invalid-message": "'%s' is not a valid AS number.",
	    "x-info": [
		{
		    "title": "Autonomous System Numbers",
		    "href": "https://www.iana.org/assignments/as-numbers/as-numbers.xhtml"
		}
	    ]
	},

        "AS": {
            "type": "object",
            "properties": {
                "number": {
		    "$ref": "#/pScheduler/ASNumber"
		},
                "owner": {
		    "$ref": "#/pScheduler/String",
		    "description": "The owner of the AS"
		}
            },
            "additionalProperties": false,
            "required": [ "number" ]
        },

        "Boolean": { "type": "boolean" },

        "Cardinal": {
            "type": "integer",
            "minimum": 1,
	    "x-description-append": "Any positive integer is valid.",
	    "examples": [ 5, 2, 19 ],
	    "x-invalid-message": "'%s' is not a positive integer."
        },

        "CardinalList": {
            "type": "array",
            "items": { "$ref": "#/pScheduler/Cardinal" }
        },

        "CardinalZero": {
            "type": "integer",
            "minimum": 0,
	    "x-description-append": "Zero or any positive integer is valid.",
	    "examples": [ 0, 1, 5, 19 ],
	    "x-invalid-message": "This must be zero or any positive integer."
        },

        "CardinalZeroList": {
            "type": "array",
            "items": { "$ref": "#/pScheduler/CardinalZero" }
        },

        "ClockState": {
            "type": "object",
            "properties": {
                "time":         { "$ref": "#/pScheduler/Timestamp" },
                "synchronized": { "$ref": "#/pScheduler/Boolean" },
                "source":       { "$ref": "#/pScheduler/String" },
                "reference":    { "$ref": "#/pScheduler/String" },
                "offset":       { "$ref": "#/pScheduler/Number" }
            },
            "additionalProperties": false,
            "required": [ "time", "synchronized" ]
        },

        "Duration": {
            "type": "string",
            "#": "ISO 8601.  Source: https://gist.github.com/philipashlock/8830168",
            "#": "Modified not to accept repeats (e.g., R5PT1M), which we don't support.",
            "#": "Modified not to accept months or years, which are inexact.",
            "pattern": "^P(?:\\d+(?:\\.\\d+)?W)?(?:\\d+(?:\\.\\d+)?D)?(?:T(?:\\d+(?:\\.\\d+)?H)?(?:\\d+(?:\\.\\d+)?M)?(?:\\d+(?:\\.\\d+)?S)?)?$",
	    "title": "Duration",
	    "x-description-append": "This can be any valid ISO 8601 duration not involving months or years, which are inexact.",
	    "examples": [ "PT10S", "PT45.67S", "PT1H30M", "P1D", "P2D3H37M" ],
            "x-invalid-message": "'%s' is not a valid ISO 8601 duration.",
	    "x-info": [
		{
		    "title": "ISO 8601 Durations",
		    "href": "https://en.wikipedia.org/wiki/ISO_8601#Durations"
		}
	    ]
        },

        "Email": {
	    "type": "string",
	    "format": "email",
	    "x-description-append": "This can be any valid email address.",
	    "examples": [ "alice@example.com", "bob@example.net", "charlie@example.edu" ],
	    "x-invalid-message": "'%s' is not a valid email address."
	},

        "Float": {
            "type": "number",
	    "x-description-append": "This can be any floating-point number.",
	    "examples": [ 3.1415, 6.022e23, 86 ],
	    "x-invalid-message": "'%s' is not a valid floating-point number."
        },

        "GeographicPosition": {
            "type": "string",
            "#": "ISO 6709",
            "#": "Source:  https://svn.apache.org/repos/asf/abdera/abdera2/common/src/main/java/org/apache/abdera2/common/geo/IsoPosition.java",
            "pattern": "^(([+-]\\d{2})(\\d{2})?(\\d{2})?(\\.\\d+)?)(([+-]\\d{3})(\\d{2})?(\\d{2})?(\\.\\d+)?)([+-]\\d+(\\.\\d+)?)?$",
	    "x-description-append": "This can be any ISO 6709 geographic position.",
	    "#": "These coordinates are the boardwalk at Rehoboth Beach, Delaware, USA.",
	    "examples": [ "+38.7166753292509-75.07609107912923" ],
	    "x-invalid-message": "'%s' is not a valid ISO 6709 geographic position.",
	    "x-info": [
		{
		    "title": "ISO 6709",
		    "href": "https://en.wikipedia.org/wiki/ISO_6709"
		}
	    ]
        },

        "Host": {
	    "#1526 WAS anyOf": [
                { "$ref": "#/pScheduler/HostName" },
                { "$ref": "#/pScheduler/IPAddress" }
	    ],
	    "type": "string",
	    "pattern": "(^[A-Za-z0-9_][A-Za-z0-9\\-]{0,62}(\\.[A-Za-z0-9][A-Za-z0-9\\-]{0,62})*\\.?$)|(^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$)|(^((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))$)",
	    "x-description-append": "Any hostname, FQDN, IPv4 address or IPv6 address is valid.",
	    "x-invalid-message": "Invalid host name.",
	    "examples": [ "host.example.net", "198.51.100.45", "2001:db8::c0de" ]
        },

        "HostName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "#": "This is derived from the pattern in the JSONSchema module",
            "#": "but allows the first element to begin with an underscore.",
            "#": "See #1514.",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9\\-]{0,62}(\\.[A-Za-z0-9][A-Za-z0-9\\-]{0,62})*\\.?$",
	    "examples": [ "host.example.net" ],
	    "x-description-append": "Any hostname as described in RFCs 952, 1123 or 2181 is valid.",
	    "x-invalid-message": "'%s' is not a valid hostname.",
	    "x-info": [
		{
		    "title": "RFC 952",
		    "href": "https://datatracker.ietf.org/doc/html/rfc952"
		},
		{
		    "title": "RFC 1123",
		    "href": "https://datatracker.ietf.org/doc/html/rfc1123"
		},
		{
		    "title": "RFC 2181",
		    "href": "https://datatracker.ietf.org/doc/html/rfc2181"
		}
	    ]
        },

        "Integer": {
	    "type": "integer",
	    "examples": [ 5, -17, 0 ],
	    "x-description-append": "Any integer is valid.",
	    "x-invalid-message": "'%s' is not a valid integer."
	},

        "IPAddress": {
            "#1526 WAS: oneOf": [
                { "type": "string", "format": "ipv4" },
                { "type": "string", "format": "ipv6" }
            ],
	    "type": "string",
	    "#": "Source: https://www.ditig.com/validating-ipv4-and-ipv6-addresses-with-regexp",
            "pattern": "(^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$)|(^((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?::[0-9A-Fa-f]{1,4}){1,7}|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,6}))$)",
	    "x-description-append": "Any IPv4 or IPv6 address is valid.",
	    "x-invalid-message": "Invalid IPv4 or IPv6 address",
	    "examples": [ "198.51.100.45", "2001:db8::bead:cafe" ]
        },

        "IPv4": {
	    "type": "string",
	    "format": "ipv4",
	    "x-description-append": "Any IPv4 address is valid.",
	    "x-invalid-message": "Invalid IPv4 address.",
	    "examples": [ "198.51.100.45", "192.0.2.68", "203.0.113.99" ]
	},

        "IPv6": {
	    "type": "string",
	    "format": "ipv6",
	    "x-description-append": "Any IPv6 address is valid.",
	    "x-invalid-message": "Invalid IPv6 address.",
	    "examples": [ "2001:db8::beef:cafe", "3fff:0123:4567:89ab:cdef:0000:1b4d:c0de" ]
	},

        "IPv6RFC2732": {
            "#": "IPv6 address with optional port, formatted per RFC 2732",
            "#": "Source: https://stackoverflow.com/a/17871737/180674",
            "type": "string",
            "pattern": "^\\[(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))\\](:[0-9]+)?$"
        },

        "IPv4CIDR": {
            "type": "string",
            "#": "Source: http://blog.markhatton.co.uk/2011/03/15/regular-expressions-for-ip-addresses-cidr-ranges-and-hostnames",
            "pattern": "^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\\/([0-9]|[1-2][0-9]|3[0-2]))$"
        },

        "IPv6CIDR": {
            "type": "string",
            "#": "Source: http://www.regexpal.com/93988",
            "pattern": "^s*((([0-9A-Fa-f]{1,4}:){7}([0-9A-Fa-f]{1,4}|:))|(([0-9A-Fa-f]{1,4}:){6}(:[0-9A-Fa-f]{1,4}|((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3})|:))|(([0-9A-Fa-f]{1,4}:){5}(((:[0-9A-Fa-f]{1,4}){1,2})|:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3})|:))|(([0-9A-Fa-f]{1,4}:){4}(((:[0-9A-Fa-f]{1,4}){1,3})|((:[0-9A-Fa-f]{1,4})?:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){3}(((:[0-9A-Fa-f]{1,4}){1,4})|((:[0-9A-Fa-f]{1,4}){0,2}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){2}(((:[0-9A-Fa-f]{1,4}){1,5})|((:[0-9A-Fa-f]{1,4}){0,3}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){1}(((:[0-9A-Fa-f]{1,4}){1,6})|((:[0-9A-Fa-f]{1,4}){0,4}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(:(((:[0-9A-Fa-f]{1,4}){1,7})|((:[0-9A-Fa-f]{1,4}){0,5}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:)))(%.+)?s*(\\/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8]))$"
        },

        "IPCIDR": {
            "#1526 WAS: oneOf": [
                { "$ref": "#/pScheduler/IPv4CIDR" },
                { "$ref": "#/pScheduler/IPv6CIDR" }
            ],
            "type": "string",
            "pattern": "(^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\\/([0-9]|[1-2][0-9]|3[0-2]))$)|(^s*((([0-9A-Fa-f]{1,4}:){7}([0-9A-Fa-f]{1,4}|:))|(([0-9A-Fa-f]{1,4}:){6}(:[0-9A-Fa-f]{1,4}|((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3})|:))|(([0-9A-Fa-f]{1,4}:){5}(((:[0-9A-Fa-f]{1,4}){1,2})|:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3})|:))|(([0-9A-Fa-f]{1,4}:){4}(((:[0-9A-Fa-f]{1,4}){1,3})|((:[0-9A-Fa-f]{1,4})?:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){3}(((:[0-9A-Fa-f]{1,4}){1,4})|((:[0-9A-Fa-f]{1,4}){0,2}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){2}(((:[0-9A-Fa-f]{1,4}){1,5})|((:[0-9A-Fa-f]{1,4}){0,3}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){1}(((:[0-9A-Fa-f]{1,4}){1,6})|((:[0-9A-Fa-f]{1,4}){0,4}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:))|(:(((:[0-9A-Fa-f]{1,4}){1,7})|((:[0-9A-Fa-f]{1,4}){0,5}:((25[0-5]|2[0-4]d|1dd|[1-9]?d)(.(25[0-5]|2[0-4]d|1dd|[1-9]?d)){3}))|:)))(%.+)?s*(\\/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8]))$)"
        },

        "IPCIDRList": {
            "type": "array",
            "items": { "$ref": "#/pScheduler/IPCIDR" }
        },

        "Int8": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127
        },

        "UInt8": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
        },

        "Int16": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767
        },

        "UInt16": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
        },

        "Int32": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
        },

        "UInt32": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
        },

        "Int64": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
        },

        "UInt64": {
            "type": "integer",
            "minimum": 0,
            "maximum": 184446744073709551615
        },

        "IPPort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
        },

        "IPPortRange": {
            "type": "object",
            "properties": {
                "lower": { "$ref": "#/pScheduler/IPPort" },
                "upper": { "$ref": "#/pScheduler/IPPort" }
            },
            "additionalProperties": false,
            "required": [ "lower", "upper" ]
        },

        "IPTOS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
	    "title": "TOS",
	    "description": "IP type of service.",
	    "examples": [ 0, 42 ],
	    "x-description-append": "Any value in [0..255] is valid.",
	    "x-info": [
		{
		    "title": "RFC 1349",
		    "href": "https://datatracker.ietf.org/doc/html/rfc1349"
		}
	    ]
        },

        "JQTransformSpecification": {
            "type": "object",
            "properties": {
                "script": {
                    "anyOf": [
                        { "$ref": "#/pScheduler/String" },
                        { "$ref": "#/pScheduler/StringList" }
                    ]
                },
                "output-raw": { "$ref": "#/pScheduler/Boolean" },
                "args": { "$ref": "#/pScheduler/AnyJSON" }
            },
            "additionalProperties": false,
            "required": [ "script" ]
        },

        "Number": {
	    "type": "number",
	    "x-description-append": "Any number is valid."
	},

        "POSIXCronSpecification": {
            "type": "string",
            "#": "POSIX-standard spec.  This was generated by",
            "#": "scripts/posix-cron-regex; see that for commentary.",
            "pattern": "^(\\*|((([0-5]?\\d)|(([0-5]?\\d)-([0-5]?\\d)))(,(([0-5]?\\d)|(([0-5]?\\d)-([0-5]?\\d))))*))\\s+(\\*|(((([01]?\\d)|2[0-3])|((([01]?\\d)|2[0-3])-(([01]?\\d)|2[0-3])))(,((([01]?\\d)|2[0-3])|((([01]?\\d)|2[0-3])-(([01]?\\d)|2[0-3]))))*))\\s+(\\*|((((0?[1-9])|([12]\\d)|(3[01]))|(((0?[1-9])|([12]\\d)|(3[01]))-((0?[1-9])|([12]\\d)|(3[01]))))(,(((0?[1-9])|([12]\\d)|(3[01]))|(((0?[1-9])|([12]\\d)|(3[01]))-((0?[1-9])|([12]\\d)|(3[01])))))*))\\s+(\\*|((((0?[1-9])|(1[0-2]))|(((0?[1-9])|(1[0-2]))-((0?[1-9])|(1[0-2]))))(,(((0?[1-9])|(1[0-2]))|(((0?[1-9])|(1[0-2]))-((0?[1-9])|(1[0-2])))))*))\\s+(\\*|(([0-6]|([0-6]-[0-6]))(,([0-6]|([0-6]-[0-6])))*))$",
            "x-invalid-message": "'%s' is not a valid cron specification.",
	    "x-description-append": "Any POSIX crontab specification is valid.",
	    "x-info": [
		{
		    "title": "Cron",
		    "href": "https://en.wikipedia.org/wiki/Cron#Overview"
		}
	    ]
        },

        "Probability": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
	    "x-invalid-message": "Value must be in [0.0..1.0].",
	    "x-description-append": "Any value in [0.0..1.0] is valid."
        },

        "RetryPolicy": {
            "type": "array",
            "items": {"$ref": "#/pScheduler/RetryPolicyEntry" }
        },

        "RetryPolicyEntry": {
            "type": "object",
            "properties": {
                "attempts": {
		    "$ref": "#/pScheduler/Cardinal",
		    "title": "Attempts",
		    "description": "How many times to try.",
		    "examples": [ "5" ]
		}, 
                "wait": {
		    "$ref": "#/pScheduler/Duration",
		    "title": "Wait",
