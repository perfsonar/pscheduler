                { "$ref": "#/pScheduler/TaskSpecification_V3" },
                { "$ref": "#/pScheduler/TaskSpecification_V4" },
                { "$ref": "#/pScheduler/TaskSpecification_V5" }
            ]
        },

        "TestSpecification": {
            "type": "object",
            "properties": {
                "type": { "$ref": "#/pScheduler/String" },
                "spec": { "$ref": "#/pScheduler/AnyJSON" }
            },
            "additionalProperties": false,
            "required": [
                "type",
                "spec"
            ]
        },

        "#": "Standard Values",

        "#": "Note that these are lowercase with hyphens, matching the style",
        "#": "of the names used.",

        "icmp-error": {
            "type": "string",
            "enum": [
                "net-unreachable",
                "host-unreachable",
                "protocol-unreachable",
                "port-unreachable",
                "fragmentation-needed-and-df-set",
                "source-route-failed",
                "destination-network-unknown",
                "destination-host-unknown",
                "source-host-isolated",
                "destination-network-administratively-prohibited",
                "destination-host-administratively-prohibited",
                "network-unreachable-for-type-of-service",
                "icmp-destination-host-unreachable-tos",
                "communication-administratively-prohibited",
                "host-precedence-violation",
                "precedence-cutoff-in-effect"
            ]
        },

        "ip-version": {
            "type": "integer",
            "enum": [ 4, 6 ]
        },

        "ip-version-list": {
            "type": "array",
            "items": { "$ref": "#/pScheduler/ip-version" }
        },

        "#": "Standard Plugin Enumeration Types",

        "PluginEnumeration": {

	    "local": {

		"SpecJSONSchemaVersions": {
		    "#": "TODO: Need to use prefixItems to make sure the first is null",
		    "type": "array",
		    "#": "TODO: Validate JSONSchema here, not just anything.",
		    "items": {
			"anyOf": [
			    { "type": "object" },
			    { "type": "null" }
			]
		    },
		    "minItems": 2
		},

		"SpecJSONSchema": {
		    "type": "object",
		    "properties": {
			"versions": { "$ref": "#/pScheduler/PluginEnumeration/local/SpecJSONSchemaVersions" }
		    },
		    "additionalProperties": false,
		    "required": [
			"versions"
		    ]		    
		},

		"SpecUISchemaVersions": {
		    "#": "TODO: Need to use prefixItems to make sure the first is null",
		    "type": "array",
		    "#": "TODO: Validate UISchema here, not just anything.",
		    "items": {
			"anyOf": [
			    { "type": "object" },
			    { "type": "null" }
			]
		    },
		    "minItems": 2
		},

		"SpecUISchema": {
		    "type": "object",
		    "properties": {
			"versions": { "$ref": "#/pScheduler/PluginEnumeration/local/SpecUISchemaVersions" }
		    },
		    "additionalProperties": false,
		    "required": [
			"versions"
		    ]		    
		},

		"Spec": {
		    "type": "object",
		    "properties": {
			"jsonschema": { "$ref": "#/pScheduler/PluginEnumeration/local/SpecJSONSchema" },
			"uischema": { "$ref": "#/pScheduler/PluginEnumeration/local/SpecUISchema" }
		    },
		    "additionalProperties": false,
		    "required": [
			"jsonschema",
			"uischema"
		    ]
		},

		"ResultSpec": {
		    "type": "object",
		    "properties": {
			"jsonschema": { "$ref": "#/pScheduler/PluginEnumeration/local/SpecJSONSchema" }
		    },
		    "additionalProperties": false,
		    "required": [
			"jsonschema"
		    ]
		}
	    },

            "Test": {
                "type": "object",
                "properties": {
                    "schema":       { "type": "integer", "const": 2 },
                    "name":         { "$ref": "#/pScheduler/String" },
                    "label":         { "$ref": "#/pScheduler/String" },
                    "description":  { "$ref": "#/pScheduler/String" },
                    "version":      { "$ref": "#/pScheduler/Version" },
                    "maintainer":   { "$ref": "#/pScheduler/Maintainer" },
                    "json-forms-compatible":   { "$ref": "#/pScheduler/Boolean" },
                    "scheduling-class": {
                        "type": "string",
                        "enum": [
                            "background",
                            "background-multi",
                            "exclusive",
                            "normal"
                        ]
                    },
		    "spec":         { "$ref": "#/pScheduler/PluginEnumeration/local/Spec" },
		    "result":       { "$ref": "#/pScheduler/PluginEnumeration/local/ResultSpec" }
                },
                "additionalProperties": false,
                "required": [
                    "name",
		    "label",
                    "description",
                    "version",
                    "maintainer",
		    "json-forms-compatible",
                    "scheduling-class",
		    "spec"
                ]
            },

            "Tool": {
                "type": "object",
                "properties": {
		    "schema":       { "type": "integer", "const": 1 },
                    "name":         { "$ref": "#/pScheduler/String" },
		    "label":        { "$ref": "#/pScheduler/String" },
                    "description":  { "$ref": "#/pScheduler/String" },
                    "version":      { "$ref": "#/pScheduler/Version" },
                    "tests":        { "$ref": "#/pScheduler/StringList" },
                    "preference":        { "$ref": "#/pScheduler/Integer" },
                    "maintainer":   { "$ref": "#/pScheduler/Maintainer" },
		    "json-forms-compatible":   { "$ref": "#/pScheduler/Boolean" },
                    "scheduling-class": {
                        "type": "string",
                        "enum": [
                            "background",
                            "background-multi",
                            "exclusive",
                            "normal"
                        ]
                    }
                },
                "additionalProperties": false,
                "required": [
                    "name",
		    "label",
                    "description",
                    "version",
                    "tests",
                    "preference",
                    "maintainer",
		    "json-forms-compatible"
                ]
            },

            "Archiver": {
                "type": "object",
                "properties": {
		    "schema":       { "type": "integer", "minimum": 1 },
                    "name":         { "$ref": "#/pScheduler/String" },
                    "label":        { "$ref": "#/pScheduler/String" },
                    "description":  { "$ref": "#/pScheduler/String" },
                    "version":      { "$ref": "#/pScheduler/Version" },
                    "maintainer":   { "$ref": "#/pScheduler/Maintainer" },
		    "json-forms-compatible":   { "$ref": "#/pScheduler/Boolean" },
		    "spec":         { "$ref": "#/pScheduler/PluginEnumeration/local/Spec" }
                },
                "additionalProperties": false,
                "required": [
                    "name",
		    "label",
                    "description",
                    "version",
                    "maintainer",
                    "spec"
                ]
            },

            "Context": {
                "type": "object",
                "properties": {
		    "schema":       { "type": "integer", "const": 2 },
                    "name":         { "$ref": "#/pScheduler/String" },
                    "label":        { "$ref": "#/pScheduler/String" },
                    "description":  { "$ref": "#/pScheduler/String" },
                    "version":      { "$ref": "#/pScheduler/Version" },
                    "maintainer":   { "$ref": "#/pScheduler/Maintainer" },
		    "json-forms-compatible":   { "$ref": "#/pScheduler/Boolean" },
		    "spec":         { "$ref": "#/pScheduler/PluginEnumeration/local/Spec" }
                },
                "additionalProperties": false,
                "required": [
                    "name",
		    "label",
                    "description",
                    "version",
                    "maintainer",
		    "json-forms-compatible",
		    "spec"
                ]
            }
        }
    }
}
