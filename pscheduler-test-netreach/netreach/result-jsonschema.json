		"error":        { "$ref": "#/pScheduler/String" },
		"diags":        { "$ref": "#/pScheduler/String" },
		"gateway-up":   { "$ref": "#/pScheduler/Boolean" },
		"network-up":   { "$ref": "#/pScheduler/Boolean" }
            },
            "required": [
		"succeeded",
		"network-up"
	    ],
	    "additionalProperties": false
        }

    ]
}
