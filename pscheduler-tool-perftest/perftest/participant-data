#!/usr/bin/env python3
#
# Return participant-specific data for a run
#

import packaging.version
import pscheduler
import perftest_utils
from perftest_defaults import *


json = pscheduler.json_load(exit_on_error=True)
result = {
    "schema": 3
}


status, out, err = pscheduler.run_program(['ib_write_bw', '--version'], timeout=2)
if status != 1:
    pscheduler.fail(f'Unable to run ib_write_bw: {err}')

try:
    version_text = out.split()[1]
    version = packaging.version.Version(version_text)
except (IndexError, packaging.version.InvalidVersion) as ex:
    pscheduler.fail(str(ex))

result['perftest-ib_write_bw-version'] = str(version)


try:
    participant = json['participant']
except KeyError:
    pscheduler.fail('Missing participant')

config = perftest_utils.get_config()

if participant in [0, 1]:
    result['server_port'] = config['server_port']
else:
    pscheduler.fail(f'Invalid participant number: {participant}. Only 2 participants are supported.')

pscheduler.succeed_json(result)
