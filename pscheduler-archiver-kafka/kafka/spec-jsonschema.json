{
    "#": "This gets merged into every version as #/local.",
    "local": {},

    "#": "The zeroth element of this is always null since there is no version 0.",
    "versions": [
        null,

        {
            "type": "object",
            "properties": {
                "schema": {
		    "$ref": "#/pScheduler/Schema",
		    "const": 1
		},
                "topic": {
		    "title": "Topic",
		    "description": "Kafka topic.",
		    "$ref": "#/pScheduler/String"
		},
                "server": {
		    "Title": "Server",
		    "description": "Kafka server.",
		    "$ref": "#/pScheduler/Host"
		}
            },
            "additionalProperties": false,
            "required": [
		"topic",
		"server"
	    ]
        },

        {
            "type": "object",
            "properties": {
                "schema": {
		    "$ref": "#/pScheduler/Schema", "const": 2
		},
                "topic": {
		    "title": "Topic",
                    "description": "Kafka topic.",
		    "$ref": "#/pScheduler/String"
		},
                "server": {
		    "title": "Server",
                    "description": "Kafka server.",
		    "$ref": "#/pScheduler/Host"
		},
                "archiver-id": {
		    "title": "Archiver ID",
                    "description": "Name of the software doing the archiving, like the User-Agent a web browser provides.",
		    "$ref": "#/pScheduler/String"
		},
                "security-protocol": {
		    "title": "Security Protocol",
		    "description": "Security protocol to use when connecting to Kafka.",
		    "default": "PLAINTEXT",
		    "enum": [
			"PLAINTEXT",
			"SSL"
		    ]
		},
                "kafka-retries": {
		    "title": "Retries",
		    "description": "Number of times the archiver will retry posting the result to Kafka.",
		    "$ref": "#/pScheduler/CardinalZero"
		},
		"retry-policy": {
                    "title": "Retry Policy",
                    "description": "Policy for retrying failed archivings.",
                    "$ref": "#/pScheduler/RetryPolicy"
                }
            },
            "additionalProperties": true,
            "required": [
		"schema",
		"topic",
		"server",
		"security-protocol"
	    ],
            "allOf": [
                {
                    "if": {
                        "properties": {
			    "security-protocol": {
				"const": "SSL"
			    }
			},
                        "required": [
			    "security-protocol"
			]
                    },
                    "then": {
                        "properties": {
                            "_ssl-cacert": {
				"title": "CA Certificate",
				"description": "Certificate authority certificate.",
				"$ref": "#/pScheduler/String"
			    },
                            "_ssl-cert": {
				"title": "SSL Certificate",
				"description": "Secure Sockets Layer certificate",
				"$ref": "#/pScheduler/String"
			    },
                            "_ssl-key": {
				"title": "SSL Key",
				"description": "Secure Sockets Layer key.",
				"$ref": "#/pScheduler/String"
			    },
                            "_ssl-password": {
				"title": "SSL Key Passphrase",
				"description": "Secure Sockets Layer key passphrase",
				"$ref": "#/pScheduler/String"
			    },
                            "ssl-checkhostname": {
				"title": "SSL Check Hostname",
				"description": "Enable this to check the server's domain name against the identity listed in the SSL certificate.",
				"$ref": "#/pScheduler/Boolean"
			    }
                        }
                    }
                }
            ]

        }
    ]
}
